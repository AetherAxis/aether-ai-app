<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wb="using:Aether.Workbench"
             x:Class="Aether.AI.App.Views.AgentsView"
             Background="{DynamicResource ContentBgBrush}">

  <!-- Agents 页 = 自定义大脑：用户自建 agent（LLM 大脑 / 规则大脑），保存即落 agents.json，
       聊天页 agent 下拉热刷新。版式与 LLM 档案页同款：页头 + 分区卡片（880 上限、卡片内 20px）。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="28,24,28,32">
      <StackPanel MaxWidth="880" Spacing="22">

        <!-- ═══ 页头 ═══ -->
        <StackPanel Spacing="4">
          <TextBlock Text="Agents" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="agent = 一个小大脑，三类都能在这建：LLM（提示词 + 工具 + 审批）、规则（正则 → 调工具/回复）、代码（一段 C# 源码，本机编译）。
                        这里列出的每一个都能改、能删——包括首次运行自带的「通用助手」；保存后立刻出现在聊天页顶部的 agent 下拉里。"
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ═══ 我的 agent ═══ -->
        <Border Classes="msg-card" Padding="20,18" CornerRadius="14">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="我的 agent" FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1" Command="{Binding NewAgentCommand}" Content="＋ 新建" Classes="primary"
                      FontSize="12" Padding="12,5" MinHeight="30"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Agents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="msg-card" Margin="0,0,0,8" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="6,1"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                          </Border>
                          <!-- 记忆标：开了长期记忆或工作笔记才出现（一眼看出这个 agent 会记事） -->
                          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="6,1"
                                  VerticalAlignment="Center" IsVisible="{Binding HasMemory}"
                                  ToolTip.Tip="已开启记忆（长期记忆 / 工作笔记）">
                            <TextBlock Text="记忆" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{Binding CompileError}" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding HasCompileError}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding EditCommand}" CommandParameter="{Binding}"
                              Content="编辑" Classes="outline" FontSize="11" VerticalAlignment="Center"
                              Foreground="{DynamicResource AccentBrush}"/>
                      <Button Grid.Column="2" Command="{Binding DeleteCommand}" CommandParameter="{Binding}"
                              Classes="outline danger" Padding="7,4" VerticalAlignment="Center" ToolTip.Tip="删除">
                        <Path Data="{x:Static wb:Codicons.Trash}" Stretch="Uniform" Width="13" Height="13"
                              Fill="{DynamicResource DangerBrush}"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="还没有 agent——用下面的表单建一个（LLM 或规则大脑都行）。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding !HasAgents}"/>
          </StackPanel>
        </Border>

        <!-- ═══ 编辑器 ═══ -->
        <Border Classes="msg-card" Padding="20,18" CornerRadius="14">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding EditorTitle}" FontSize="14" FontWeight="SemiBold"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding FormName}" PlaceholderText="如：日志分析员" FontSize="13" MinHeight="36"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="大脑类型" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox SelectedIndex="{Binding FormKindIndex}" MinHeight="36" FontSize="13"
                          HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="LLM 大脑（提示词 + 工具）"/>
                  <ComboBoxItem Content="规则大脑（正则 → 动作，零 key）"/>
                  <ComboBoxItem Content="代码大脑（C# 源码，本机编译）"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Text="说明（给目录/下拉看的一句话）" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding FormDescription}" PlaceholderText="如：把一段日志里的报错挑出来并解释"
                       FontSize="13" MinHeight="36"/>
            </StackPanel>

            <!-- ——— LLM 大脑 ——— -->
            <StackPanel Spacing="14" IsVisible="{Binding IsLlmForm}">
              <StackPanel Spacing="6">
                <TextBlock Text="系统提示词" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding FormInstructions}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="110" FontSize="13"
                         PlaceholderText="你是……。回答时……；需要时调用工具……。"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="模型档案" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ComboBox ItemsSource="{Binding ModelProfiles}" SelectedItem="{Binding FormModelProfile}"
                            MinHeight="36" FontSize="13" HorizontalAlignment="Stretch"
                            ToolTip.Tip="「跟随当前选中档案」= 聊天页模型下拉切换时本 agent 也跟着换"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="行为" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" MinHeight="36">
                    <CheckBox IsChecked="{Binding FormModePicker}" FontSize="12"
                              Content="4 档运行模式" ToolTip.Tip="规划 / 手动 / 自动编辑 / 自动"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- 记忆：两种能力都在数据目录里落盘，手机与桌面同一份档案、同一个库 -->
              <StackPanel Spacing="4">
                <TextBlock Text="记忆" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Spacing="2">
                  <CheckBox IsChecked="{Binding FormLongTermMemory}" FontSize="12" Content="长期记忆（跨会话）"
                            ToolTip.Tip="每轮前召回、每轮后沉淀到 memory.db——换会话、重启、换端都还记得"/>
                  <CheckBox IsChecked="{Binding FormFileMemory}" FontSize="12" Content="工作笔记（agent 自建笔记库）"
                            ToolTip.Tip="agent 可读写自己的笔记文件（数据目录/agent-notes/&lt;id&gt;/），适合长文档整理"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- ——— 代码大脑 ——— -->
            <StackPanel Spacing="14" IsVisible="{Binding IsCodeForm}">
              <StackPanel Spacing="6">
                <TextBlock Text="源码（C#：继承 CodeRuleBrain 的非抽象类，重写 RunAsync）" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding FormSourceCode}" AcceptsReturn="True" TextWrapping="NoWrap"
                         MinHeight="230" FontSize="12" FontFamily="Menlo,Consolas,monospace"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="可用：UserText（本轮用户消息）/ History / Step / LastResult / RunCancellationToken；await Call(&quot;工具名&quot;, new { ... }) 调工具，框架负责执行并回填结果。源码没有隐式 using（Task、List 等要自己 using），在本机编译执行——只运行你信任的代码（桌面端可用）。"/>
              </StackPanel>
            </StackPanel>

            <!-- ——— 共用：工具与审批（三类大脑都调工具——规则大脑的白名单 = 勾选集，动作工具从中选） ——— -->
            <StackPanel Spacing="14">
              <CheckBox IsChecked="{Binding FormRequireApproval}" FontSize="12" Content="工具调用前审批"/>
              <StackPanel Spacing="6">
                <TextBlock Text="允许的工具" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,8">
                  <!-- 按类别分组（可展开/收起）：组头 = 折叠箭头 + 三态勾选（勾=全选/取消=全不选/部分=不定态）；
                       默认收起——组头勾选态不展开也可见可操作；子项仅展开后显示 -->
                  <ItemsControl ItemsSource="{Binding ToolGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,3">
                          <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                            <ToggleButton Grid.Column="0" Width="20" Height="20" Padding="0" Focusable="False"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsExpanded}" ToolTip.Tip="展开/收起">
                              <Panel>
                                <TextBlock Text="▸" FontSize="11" IsVisible="{Binding !IsExpanded}"/>
                                <TextBlock Text="▾" FontSize="11" IsVisible="{Binding IsExpanded}"/>
                              </Panel>
                            </ToggleButton>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked}" IsThreeState="True"
                                      FontSize="12" FontWeight="SemiBold" Content="{Binding Header}"/>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Tools}" Margin="16,2,0,2" IsVisible="{Binding IsExpanded}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="4"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" FontSize="12" Content="{Binding Name}"
                                          ToolTip.Tip="{Binding Description}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- ——— 规则大脑 ——— -->
            <StackPanel Spacing="14" IsVisible="{Binding IsRuleForm}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="触发正则（匹配最新一条用户消息；空 = 任意消息）" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBox Text="{Binding FormMatchRegex}" PlaceholderText="^查(.+)$" FontSize="13" MinHeight="36"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="未命中兜底回复" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBox Text="{Binding FormNoMatchReply}" FontSize="13" MinHeight="36"/>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="动作：调用工具（从「允许的工具」勾选里选）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ComboBox ItemsSource="{Binding RuleToolNames}" SelectedItem="{Binding FormToolName}"
                            MinHeight="36" FontSize="13" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding UsesRuleTool}">
                  <TextBlock Text="工具参数（JSON；值里可用 {user.1} / {result}）" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBox Text="{Binding FormToolArgs}" AcceptsReturn="True" TextWrapping="Wrap"
                           FontSize="12" MinHeight="36" FontFamily="Menlo,Consolas,monospace"/>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Text="回复模板（调工具时 = 拿到结果后的回复；模板里可用 {result} / {user.N}）"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding FormReplyTemplate}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" FontSize="13" PlaceholderText="done:{result}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Command="{Binding SaveAgentCommand}" Content="{Binding SaveButtonText}"
                      Classes="primary" Padding="16,8" FontSize="13" MinHeight="38"/>
              <Button Command="{Binding CancelEditCommand}" Content="取消"
                      Padding="16,8" FontSize="13" MinHeight="38"/>
              <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                         IsVisible="{Binding HasStatus}"
                         Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
