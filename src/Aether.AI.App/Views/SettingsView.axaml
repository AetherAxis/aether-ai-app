<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wb="using:Aether.Workbench"
             x:Class="Aether.AI.App.Views.SettingsView"
             Background="{DynamicResource ContentBgBrush}">

  <!-- 设置页 = rail 左下角齿轮直达的那一页，只管**宿主级**的东西：外观（主题）+ 布局（重置）。
       LLM 连接档案不在这里——它是聊天那头的事，由输入卡的「模型 ⚙」打开 LlmProfilesView
       （同一份 SettingsViewModel，配置即时生效、chips 随 Changed 刷新）。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="28,24,28,32">
      <StackPanel MaxWidth="880" Spacing="22">

        <!-- ═══ 页头 ═══ -->
        <StackPanel Spacing="4">
          <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="外观与布局——改动即时生效并持久化到本机。模型与密钥在聊天输入卡的「模型 ⚙」里管理。"
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ═══ 外观（原 rail 底部齿轮 flyout 的两项——主题 + 重置布局，随底部入口合并进设置页）═══ -->
        <Border Classes="msg-card" Padding="20,18" CornerRadius="14">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3">
              <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="主题切换即时生效并持久化；重置布局会清掉分隔条位置与当前 tab。"
                         FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 主题 chips：**不要**套 Border.chip（那个样式写死 Height=26，会把文字压成一条缝）；
                 用自适应高度的容器，chip 自身给足内距与最小高度。 -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12,10">
              <ItemsControl ItemsSource="{Binding Shell.Themes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="llm-chip" Classes.current="{Binding IsCurrent}" Content="{Binding Name}"
                            Padding="14,7" FontSize="12" MinHeight="32"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8"
                            Command="{Binding SelectCommand}" CommandParameter="{Binding Name}"
                            ToolTip.Tip="{Binding Description}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <Button Classes="outline" HorizontalAlignment="Left" Padding="10,6"
                    Command="{Binding Shell.ResetLayoutCommand}"
                    ToolTip.Tip="清除已保存的布局（分隔条位置 / 当前 tab），回到默认工作台">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{x:Static wb:Codicons.Refresh}" Stretch="Uniform" Width="12" Height="12"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      VerticalAlignment="Center"/>
                <TextBlock Text="重置布局" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <!-- ═══ 技能包与连接器（手机桌面同一份目录布局；本机跑不了的就明说，不静默降级）═══ -->
        <Border Classes="msg-card" Padding="20,18" CornerRadius="14" IsVisible="{Binding HasCapabilities}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="技能包与连接器" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HostCapabilityText}"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="outline" Padding="10,6" VerticalAlignment="Top"
                      Command="{Binding RefreshCapabilitiesCommand}">
                <TextBlock Text="刷新" FontSize="12" VerticalAlignment="Center"/>
              </Button>
            </Grid>

            <!-- 目录：把 SKILL.md / mcp 配置放进去即生效（与桌面同一份路径结构，可跨端同步） -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Text="技能包目录" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <SelectableTextBlock Text="{Binding SkillsDirectory}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="连接器目录" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                <SelectableTextBlock Text="{Binding McpServersDirectory}" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding HasSkills}">
              <TextBlock Text="已加载技能包" FontSize="12" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding Skills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Category}" FontSize="10"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasMcpServers}">
              <TextBlock Text="已配置连接器（MCP）" FontSize="12" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding McpServers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Transport}" FontSize="10"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding CapabilitiesStatus}" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding HasCapabilitiesStatus}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
