<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wb="using:Aether.Workbench"
             xmlns:views="using:Aether.AI.App.Views"
             x:Class="Aether.AI.App.Views.SettingsView"
             Background="{DynamicResource ContentBgBrush}">

  <!-- 设置页 = rail 左下角齿轮直达的那一页，只管**宿主级**的东西：外观（主题）+ 布局（重置）。
       LLM 连接档案不在这里——它是聊天那头的事，由输入卡的「模型 ⚙」打开 LlmProfilesView
       （同一份 SettingsViewModel，配置即时生效、chips 随 Changed 刷新）。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="28,24,28,32">
      <StackPanel MaxWidth="880" Spacing="22">

        <!-- ═══ 页头 ═══ -->
        <StackPanel Spacing="4">
          <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="外观与布局、技能包与连接器、链上钱包——改动即时生效并持久化到本机。模型与密钥在聊天输入卡的「模型 ⚙」里管理。"
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ═══ 外观（原 rail 底部齿轮 flyout 的两项——主题 + 重置布局，随底部入口合并进设置页）═══ -->
        <Border Classes="msg-card" Padding="20,18" CornerRadius="14">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3">
              <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="主题切换即时生效并持久化；重置布局会清掉分隔条位置与当前 tab。"
                         FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 主题 chips：**不要**套 Border.chip（那个样式写死 Height=26，会把文字压成一条缝）；
                 用自适应高度的容器，chip 自身给足内距与最小高度。 -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12,10">
              <ItemsControl ItemsSource="{Binding Shell.Themes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="llm-chip" Classes.current="{Binding IsCurrent}" Content="{Binding Name}"
                            Padding="14,7" FontSize="12" MinHeight="32"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8"
                            Command="{Binding SelectCommand}" CommandParameter="{Binding Name}"
                            ToolTip.Tip="{Binding Description}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <Button Classes="outline" HorizontalAlignment="Left" Padding="10,6"
                    Command="{Binding Shell.ResetLayoutCommand}"
                    ToolTip.Tip="清除已保存的布局（分隔条位置 / 当前 tab），回到默认工作台">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{x:Static wb:Codicons.Refresh}" Stretch="Uniform" Width="12" Height="12"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      VerticalAlignment="Center"/>
                <TextBlock Text="重置布局" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <!-- ═══ 技能包 / 连接器 / 链上钱包（与移动「设置」浮层同一份控件 CapabilitiesView）═══ -->
        <views:CapabilitiesView/>

      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
