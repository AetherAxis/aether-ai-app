<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wb="using:Aether.Workbench"
             x:Class="Aether.AI.App.Views.LlmProfilesView"
             Background="{DynamicResource ContentBgBrush}">

  <!-- LLM 连接档案的**唯一**管理面（2026-10-26 三改）：
       设置页（外观）与聊天「模型 ⚙」都宿本控件 —— 一份 XAML、一个 SettingsViewModel 单例，
       不再各写一份。桌面 = 模态窗，移动 = ChatView 内嵌浮层。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="24,20,24,24">
      <StackPanel MaxWidth="760" Spacing="14">

        <StackPanel Spacing="3">
          <TextBlock Text="LLM 连接档案" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="选中的档案 = 所有「跟随当前档案」的 agent（默认「通用助手」即是）用的模型——切换后下一轮对话生效，无需重启。密钥只存本机 llm-configs.json。"
                     FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Classes="msg-card" Padding="20,18" CornerRadius="14">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="档案列表" FontSize="12" FontWeight="Medium"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Grid.Column="1" Command="{Binding NewConfigCommand}" Content="＋ 新增" Classes="primary"
                      FontSize="12" Margin="16,0,0,0" Padding="12,5" MinHeight="30"/>
            </Grid>

            <!-- 档案列表 -->
            <ItemsControl ItemsSource="{Binding Configs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="msg-card" Margin="0,0,0,8" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                      <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsCurrent}"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="当前" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" IsVisible="{Binding IsCurrent}"/>
                        </StackPanel>
                        <!-- 长的 model / endpoint 必须省略，否则会压到右侧按钮下面 -->
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1">
                          <Run Text="{Binding ModelId}"/><Run Text=" · "/><Run Text="{Binding Endpoint}"/>
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="2" Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                              Content="设为当前" Classes="outline" FontSize="11" IsVisible="{Binding !IsCurrent}"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource AccentBrush}"/>
                      <Button Grid.Column="3" Command="{Binding EditCommand}" CommandParameter="{Binding}"
                              Classes="outline" Padding="7,4" VerticalAlignment="Center" ToolTip.Tip="编辑">
                        <Path Data="{x:Static wb:Codicons.Edit}" Stretch="Uniform" Width="13" Height="13"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </Button>
                      <Button Grid.Column="4" Command="{Binding DeleteCommand}" CommandParameter="{Binding}"
                              Classes="outline danger" Padding="7,4" VerticalAlignment="Center" ToolTip.Tip="删除">
                        <Path Data="{x:Static wb:Codicons.Trash}" Stretch="Uniform" Width="13" Height="13"
                              Fill="{DynamicResource DangerBrush}"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="还没有档案——填下面的表单添加一个（OpenAI 兼容 endpoint 均可）。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding !HasConfigs}"/>

            <Border Height="1" Background="{DynamicResource BorderBrush}"/>

            <!-- 表单（新增/编辑共用） -->
            <StackPanel Spacing="12">
              <TextBlock Text="新增 / 编辑档案" FontSize="12" FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBox Text="{Binding FormName}" PlaceholderText="如：本地 GLM" FontSize="13" MinHeight="36"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="模型" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBox Text="{Binding FormModelId}" PlaceholderText="如：glm-4.7" FontSize="13" MinHeight="36"/>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Text="Endpoint（OpenAI 官方可留空）" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding FormEndpoint}" PlaceholderText="https://api.example.com/v1"
                         FontSize="13" MinHeight="36"/>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="API Key" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding FormApiKey}" PasswordChar="•" PlaceholderText="sk-…"
                         FontSize="13" MinHeight="36"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding SaveConfigCommand}" Content="{Binding SaveButtonText}"
                        Classes="primary" Padding="16,8" FontSize="13" MinHeight="38"/>
                <Button Command="{Binding TestConnectionCommand}" Content="测试连接"
                        Padding="16,8" FontSize="13" MinHeight="38"
                        IsEnabled="{Binding !IsTesting}"/>
              </StackPanel>
              <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding HasStatus}"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
