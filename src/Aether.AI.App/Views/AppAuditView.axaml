<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Aether.AI.App.Views"
             x:Class="Aether.AI.App.Views.AppAuditView"
             Background="{DynamicResource ContentBgBrush}">

  <!-- 应用审查页：**只发布任务、只显示结论**，自己不搜也不判。
       粘贴一行一条 → 「导入清单」（待发布）→「发布任务」进任务池 → agent 用 ListAuditTasks 取、自己找证据判、
       用 SaveAppVerdict 写回；本页在 store.Changed 上刷新。数据落 <dataDir>/app-audit.json（两端同一份）。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="28,24,28,32">
      <StackPanel MaxWidth="1080" Spacing="18">

        <!-- ═══ 页头 ═══ -->
        <StackPanel Spacing="4">
          <TextBlock Text="应用审查" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="发布一份应用名清单（手机上以 Chrome 网页应用方式装的那些），由 agent 反查它们对应的网站、给出站点类型与是否博彩，结论写回这里显示。这页只发布任务，不判定。"
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ═══ 工具条：导入清单 + 驱动 ═══ -->
        <Border Classes="msg-card" Padding="18,16" CornerRadius="14">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="审查清单" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SummaryText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CheckBox Content="含已判过的（复核）" FontSize="11" VerticalAlignment="Center"
                          IsChecked="{Binding IncludeJudged}"
                          ToolTip.Tip="勾上后「发布任务」会把已有结论的也重新放进任务池：旧结论不清空、留在历史里，行上标「待复核」"/>
                <Button Classes="primary" Content="{Binding PublishButtonText}" Padding="14,7" FontSize="12"
                        Command="{Binding PublishCommand}"
                        ToolTip.Tip="把待发布的名字放进任务池，等 agent 读取并判定（本页不发请求、不判定）"/>
              </StackPanel>
            </Grid>

            <!-- 清单输入：一行一个名字，可带网址 -->
            <TextBox Text="{Binding ImportText}" AcceptsReturn="True" MinHeight="96" MaxHeight="180"
                     FontSize="12" TextWrapping="Wrap"
                     PlaceholderText="一行一个应用名（可带网址）&#10;Sunwin&#10;LuckyBet https://example.com"/>

            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
              <Button Grid.Column="0" Classes="outline" Content="导入清单" Padding="14,7" FontSize="12"
                      Command="{Binding ImportPastedCommand}"
                      ToolTip.Tip="把上面文本框里的名字加进清单（状态=待发布，已有结论不受影响）"/>
              <Button Grid.Column="1" Classes="outline danger" Content="清空" Padding="12,7" FontSize="12"
                      Command="{Binding ClearCommand}" ToolTip.Tip="清空全部记录（文件保留，下次重新导入）"/>
            </Grid>

            <TextBlock Text="{Binding FlowHint}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding HasStatus}"
                       Foreground="{DynamicResource AccentBrush}"/>
          </StackPanel>
        </Border>

        <!-- ═══ 记录列表 ═══ -->
        <StackPanel Spacing="6">
          <TextBlock Text="还没有记录——把应用名粘到上面的输入框，一行一条，点「导入清单」"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                     IsVisible="{Binding !HasRows}"/>

          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="msg-card" Padding="14,10" CornerRadius="10" Margin="0,0,0,6"
                        ToolTip.Tip="{Binding HistoryText}" ToolTip.ShowDelay="600">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="170,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                      <!-- 应用名 -->
                      <TextBlock Grid.Column="0" Text="{Binding AppName}" FontSize="13" FontWeight="SemiBold"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <!-- 反查到的网站（可选中复制；多个候选时标 +N） -->
                      <SelectableTextBlock Grid.Column="1" Text="{Binding CandidatesText}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <!-- 站点类型（是什么类型的网站） -->
                      <TextBlock Grid.Column="2" Text="{Binding TypeText}" FontSize="11" MinWidth="56"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <!-- 博彩结论徽章 -->
                      <Border Grid.Column="3" Classes="badge"
                              Classes.gambling="{Binding IsGambling}"
                              Classes.clean="{Binding IsClean}"
                              Classes.uncertain="{Binding IsUncertain}">
                        <TextBlock Text="{Binding VerdictLabel}"/>
                      </Border>
                      <TextBlock Grid.Column="4" Text="{Binding ConfidenceText}" FontSize="11"
                                 VerticalAlignment="Center" MinWidth="34"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <Button Grid.Column="5" Classes="outline" Content="重发" Padding="10,4" FontSize="11"
                              Command="{Binding RepublishCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="把这一条重新放进任务池，让 agent 再判一次（旧结论留在历史里）"/>
                    </Grid>
                    <!-- 第二行：阶段 · 理由 / 错误 -->
                    <TextBlock Text="{Binding SecondLine}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ═══ 说明（流程 + 口径；免得把「不确定」误读成「非博彩」）═══ -->
        <Border Classes="msg-card" Padding="16,12" CornerRadius="12">
          <StackPanel Spacing="6">
            <TextBlock Text="任务流与判定口径" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="【流程】本页导入 + 发布 → agent 用 ListAuditTasks 读任务 → 自己搜/抓证据判定 → 用 SaveAppVerdict 写回 → 本页显示。【谁判】判定者、搜索深度、看几页都由 agent 决定，不在本页代码里；换 agent 或换口径都不用改这页。"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="【类型】给出简短标签：体育博彩 / 真人赌场 / 棋牌 / 视频 / 直播 / 社交 / 电商 / 新闻资讯 / 工具 / 软件下载 / 网盘 / 游戏 / 色情 / 金融理财 / 诈骗站 / 未知。【博彩】博彩 = 真钱赌博站点（体育/真人/老虎机/彩票投注/棋牌兑现）或知名博彩品牌的镜像站；非博彩 = 正常业务站点；不确定 = 证据不足（搜到的都是无关站点、同名不同义等）——不确定 ≠ 干净，需要人工复核。"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
