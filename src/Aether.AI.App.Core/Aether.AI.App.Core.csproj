<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aether.AI.App.Core</RootNamespace>
    <!-- 无 Avalonia 引用：聊天引擎/持久化/运行桥可在任何宿主（桌面/移动/未来 console/服务器）复用。
         UI 线程调度经 IUiDispatcher 端口注入，审批经 IApprovalDialogService 端口注入。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 解析类纯函数（SiteSearch.ParseBing 等）留 internal：它们是实现细节，
         但要能被测试直接喂一段真实形状的 HTML 验回归。 -->
    <InternalsVisibleTo Include="Aether.AI.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⑫ AI 平台：Hosting（传递 Harness/Core/Brains.Abstractions/Memory）+ SQLite 落盘。
         大脑实现的取舍（Rule/LLM/编译）留在组合根（App 层）——Core 只认 HarnessRuntime。 -->
    <ProjectReference Include="..\..\..\aether-ai\src\Aether.AI.Hosting\Aether.AI.Hosting.csproj" />
    <ProjectReference Include="..\..\..\aether-ai\src\Aether.AI.Memory.Sqlite\Aether.AI.Memory.Sqlite.csproj" />
    <!-- ⑫ 平台 DTO（IMcpServerConfig/McpServerConfig 等纯数据契约）——能力取舍判定（AiCapabilityPolicy）要认
         MCP server 的 transport，但不需要 MCP 客户端本身（那是 App 层的事）。 -->
    <ProjectReference Include="..\..\..\aether-ai\src\Aether.AI.Abstractions\Aether.AI.Abstractions.csproj" />
    <!-- 代码大脑的编译管线契约（CodeNote/ICodeCompilationService——纯抽象，本层不带 Roslyn）。
         Roslyn 编译器只在桌面 head 注册，移动闭包保持干净。 -->
    <ProjectReference Include="..\..\..\aether-ai\src\Aether.AI.Brains.Code.Compilation\Aether.AI.Brains.Code.Compilation.csproj" />
  </ItemGroup>

</Project>
